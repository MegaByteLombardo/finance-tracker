# Cloudflare R2 credentials for Litestream — PLACEHOLDERS ONLY.
#
# Copy this to the server, never into the repository:
#
#   sudo install -d -m 700 -o "$USER" -g "$USER" /etc/finance-tracker
#   cp deploy/litestream.env.example /etc/finance-tracker/litestream.env
#   chmod 600 /etc/finance-tracker/litestream.env
#   ${EDITOR:-vi} /etc/finance-tracker/litestream.env
#
# compose.prod.yaml loads this file into the litestream service ONLY. The
# application container never sees these values: it has no reason to reach R2,
# and a credential that is not present cannot be leaked by a process that does
# not need it.
#
# The file is owned by the user that runs `docker compose`, not by root, because
# Compose reads it as that user. 600 means that user and nobody else.
#
# Git will not accept the real file: .gitignore ignores every *.env and
# re-includes only *.env.example. Verify before a first push:
#
#   git check-ignore -v /path/to/litestream.env

# Cloudflare account id. Forms the S3 endpoint host:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Found on the R2 overview page in the Cloudflare dashboard.
R2_ACCOUNT_ID=0000000000000000000000000000000

# The bucket holding the replica. Private, used for nothing else, and with no
# public access and no r2.dev domain enabled.
R2_BUCKET=finance-tracker-backups

# R2 API token, scoped to THAT ONE BUCKET with "Object Read & Write".
#
# Not an account-wide token: this credential lives on a machine whose whole
# design assumption is that it may be destroyed or reclaimed without warning,
# and the blast radius of losing it should be one bucket of backups.
#
# The variable names are Litestream's own, which is why they are not spelled
# R2_ACCESS_KEY_ID -- Litestream reads LITESTREAM_* from the environment
# directly, and renaming them would mean mapping them again in the config.
LITESTREAM_ACCESS_KEY_ID=replace-with-the-r2-access-key-id
LITESTREAM_SECRET_ACCESS_KEY=replace-with-the-r2-secret-access-key
