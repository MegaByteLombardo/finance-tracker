# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# Every variable below is optional: the defaults shown are what the application
# uses when the variable is unset, so `go run ./cmd/web` works with no .env at
# all. Docker Compose reads this file directly, so no dotenv library is needed.

# Deployment context. One of: development, production.
# Selects the log format -- development prints readable text, production prints
# JSON. Default: development
APP_ENV=development

# Address the HTTP server listens on, as host:port. An empty host means all
# interfaces. Default: :8080
#
# Note: under Docker Compose this is fixed to :8080 inside the container; use
# HTTP_PORT below to change the port on your machine.
HTTP_ADDR=:8080

# Host port published by Docker Compose. Only read by compose.yaml, not by the
# application. Default: 8080
HTTP_PORT=8080

# Path to the SQLite database file. Its parent directory is created on startup.
# Default: ./data/finance.db
#
# Under Docker Compose this is set to /data/finance.db, which is a named volume,
# so the database survives `docker compose down`.
DB_PATH=./data/finance.db

# Where database snapshots are written. Default: ./backups
#
# Under Docker Compose this is /backups, which is bind-mounted from ./backups on
# the host. That is deliberate and should not be changed to a named volume:
# `docker compose down -v` destroys every volume in the project, so backups kept
# in one would be destroyed along with the database they exist to protect.
BACKUP_DIR=./backups

# How many SHUTDOWN backups to keep. Default: 10. Zero keeps every one.
#
# Only shutdown snapshots are pruned. Manual, pre-migration and pre-restore
# snapshots are never removed automatically -- each of those was taken because
# someone or something decided it was worth keeping.
BACKUP_RETENTION=10

# Minimum log level. One of: debug, info, warn, error. Default: info
LOG_LEVEL=info

# --- Exchange rates (M5) -----------------------------------------------------
#
# These control the EXTERNAL source of reference exchange rates. None of them is
# required for Finance Tracker to work: with the source switched off, or with no
# network at all, accounts, the ledger, balances, manually entered rates and the
# consolidated net worth all behave identically.

# Whether to fetch rates from the Banco Central de Venezuela at all.
# Default: true. Set to false to rely on manual entry only.
FX_BCV_ENABLED=true

# Where the rates are read from. Default: https://www.bcv.org.ve/
#
# Configurable for tests and rehearsals. Note that the additional TLS trust
# anchor the real host needs -- its published certificate chain is broken, see
# docs/technical-decisions.md TD-050 -- is applied ONLY when this names
# www.bcv.org.ve. Any other address gets ordinary certificate verification.
FX_BCV_URL=https://www.bcv.org.ve/

# Bounds one fetch, end to end. Default: 15s
FX_BCV_TIMEOUT=15s

# How often the background refresher WAKES UP. Default: 4h
#
# This is not how often it fetches: a fetch happens at most once per Venezuelan
# calendar day. What this really sets is the retry cadence on a day when the BCV
# is unreachable -- six attempts rather than the twenty-four an hourly tick would
# make.
FX_REFRESH_EVERY=4h

# --- Production (M6) ---------------------------------------------------------
#
# Everything below is read ONLY by compose.prod.yaml, never by the application.
# None of it belongs in a development .env; it is here so that the server's .env
# can be written from one place six months from now.
#
# On the server:
#
#   cp .env.example .env     # then delete the development section above
#   chmod 640 .env
#
# No secret appears in this file or in the server's .env. The Cloudflare R2
# credentials live in /etc/finance-tracker/litestream.env (chmod 600) and are
# loaded into the litestream service alone. See deploy/litestream.env.example.

# Makes a bare `docker compose up -d` on the server resolve to the production
# stack instead of the development one. Set this ONLY on the server.
#COMPOSE_FILE=compose.prod.yaml

# Production defaults to JSON logging.
#APP_ENV=production

# Which host interface the application port is published on.
#
# 127.0.0.1 and nothing else. The application is reached through Tailscale
# Serve, which runs on the host and proxies to this address; nothing in the OCI
# VCN can route to it. Changing this to 0.0.0.0 would put a personal finance
# application on the public internet, and no firewall rule would stop it --
# Docker's port publishing inserts its NAT rules ahead of the usual chains.
#HTTP_BIND=127.0.0.1
#HTTP_PORT=8080

# The application image, pinned to a commit. Never `latest`: rollback is setting
# this back to the previous tag, which only means something if the tag is
# specific.
#
#   docker build -t "finance-tracker:$(git rev-parse --short HEAD)" .
#
#APP_IMAGE=finance-tracker:1a2b3c4

# Litestream, pinned by digest. The tag is kept alongside it for readability;
# the digest is what is resolved. 0.5.x cannot restore a replica written by
# 0.3/0.4, so the major version is not a detail.
#LITESTREAM_IMAGE=litestream/litestream:0.5.17@sha256:4b02b9859a6b6b4087d8b8944e15f7e984bd7957cba322bbeee38b0e27b9656a

# Where the data actually lives on the server: three directories on the OCI
# Block Volume, mounted by UUID at /srv/finance-tracker and owned by uid 65532,
# which is the uid the container runs as.
#
# They are bind mounts rather than named volumes so that `ls` answers the
# question "where is my database" without asking Docker, and so that recovering
# from a lost instance is re-attaching a volume rather than copying one.
#DATA_HOST_DIR=/srv/finance-tracker/data
#BACKUP_HOST_DIR=/srv/finance-tracker/backups
#LITESTREAM_HOST_DIR=/srv/finance-tracker/litestream

# Where the R2 credentials are read from. The default is correct; it is a
# variable so a disaster-recovery rehearsal can point a throwaway stack at a
# different bucket without editing the file that runs production.
#LITESTREAM_ENV_FILE=/etc/finance-tracker/litestream.env
