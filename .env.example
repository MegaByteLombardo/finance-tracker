# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# Every variable below is optional: the defaults shown are what the application
# uses when the variable is unset, so `go run ./cmd/web` works with no .env at
# all. Docker Compose reads this file directly, so no dotenv library is needed.

# Deployment context. One of: development, production.
# Selects the log format -- development prints readable text, production prints
# JSON. Default: development
APP_ENV=development

# Address the HTTP server listens on, as host:port. An empty host means all
# interfaces. Default: :8080
#
# Note: under Docker Compose this is fixed to :8080 inside the container; use
# HTTP_PORT below to change the port on your machine.
HTTP_ADDR=:8080

# Host port published by Docker Compose. Only read by compose.yaml, not by the
# application. Default: 8080
HTTP_PORT=8080

# Path to the SQLite database file. Its parent directory is created on startup.
# Default: ./data/finance.db
#
# Under Docker Compose this is set to /data/finance.db, which is a named volume,
# so the database survives `docker compose down`.
DB_PATH=./data/finance.db

# Minimum log level. One of: debug, info, warn, error. Default: info
LOG_LEVEL=info
