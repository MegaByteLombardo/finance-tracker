# Compiled binaries
/finance-tracker
/finance-tracker.exe
/bin/
/dist/

# Test & coverage artifacts
*.test
*.test.exe
*.out
coverage.*

# Local environment (never commit real values)
.env
.env.local

# Local SQLite database -- NEVER commit personal financial data.
# The database file plus its WAL/SHM sidecars all live under data/.
/data/
*.db
*.db-wal
*.db-shm

# Backups are snapshots of that same personal data, so they are just as
# sensitive. The directory itself IS tracked, through backups/.gitkeep: it must
# exist in a checkout because compose bind-mounts it with create_host_path
# disabled, which stops Docker creating it as root.
/backups/*
!/backups/.gitkeep

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

*.txt
*.png
