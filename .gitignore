# Compiled binaries
/finance-tracker
/finance-tracker.exe
/bin/
/dist/

# Test & coverage artifacts
*.test
*.test.exe
*.out
coverage.*

# Local environment, and every production secret file.
#
# The rule is "any .env is ignored, any .env.example is tracked", stated that
# way round on purpose. Listing specific filenames is how a new one -- a
# deploy/litestream.env holding Cloudflare R2 credentials, say -- gets committed
# by somebody who did not think to add it here first.
.env
.env.*
*.env
!.env.example
!*.env.example

# Local SQLite database -- NEVER commit personal financial data.
# The database file plus its WAL/SHM sidecars all live under data/.
/data/
*.db
*.db-wal
*.db-shm

# Backups are snapshots of that same personal data, so they are just as
# sensitive. The directory itself IS tracked, through backups/.gitkeep: it must
# exist in a checkout because compose bind-mounts it with create_host_path
# disabled, which stops Docker creating it as root.
/backups/*
!/backups/.gitkeep

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

*.txt
*.png
